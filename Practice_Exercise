        "#Exercise 3\n",
        "def get_pshs_grade(raw_grade):\n",
        "    if raw_grade < 0 or raw_grade > 100:\n",
        "        return \"Invalid raw grade.\"\n",
        "    elif raw_grade >= 96:\n",
        "        return 1.00\n",
        "    elif raw_grade >= 90:\n",
        "        return 1.25\n",
        "    elif raw_grade >= 84:\n",
        "        return 1.50\n",
        "    elif raw_grade >= 78:\n",
        "        return 1.75\n",
        "    elif raw_grade >= 72:\n",
        "        return 2.00\n",
        "    elif raw_grade >= 66:\n",
        "        return 2.25\n",
        "    elif raw_grade >= 60:\n",
        "        return 2.50\n",
        "    elif raw_grade >= 55:\n",
        "        return 2.75\n",
        "    elif raw_grade >= 50:\n",
        "        return 3.00\n",
        "    elif raw_grade >= 40:\n",
        "        return 4.00\n",
        "    else:\n",
        "        return 5.00\n",
        "\n",
        "\n",
        "raw_grade = float(input(\"Enter raw grade: \"))\n",
        "equivalent = get_pshs_grade(raw_grade)\n",
        "\n",
        "if isinstance(equivalent, str):\n",
        "    print(equivalent)\n",
        "else:\n",
        "    print(f\"Equivalent PSHS grade: {equivalent:.2f}\")"
